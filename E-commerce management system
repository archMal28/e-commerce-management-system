-- ============================================================
-- TRIGGER 1: AUTOMATICALLY UPDATE ORDER TOTAL
-- ============================================================
DELIMITER $$

CREATE TRIGGER trg_order_item_after_insert
AFTER INSERT ON order_items
FOR EACH ROW
BEGIN
    UPDATE orders
    SET total_amount = (
        SELECT COALESCE(SUM(subtotal),0)
        FROM order_items
        WHERE order_id = NEW.order_id
    )
    WHERE order_id = NEW.order_id;
END$$

DELIMITER ;

-- Recalculate totals for sample orders
UPDATE orders o
SET total_amount = (
    SELECT COALESCE(SUM(oi.subtotal),0)
    FROM order_items oi
    WHERE oi.order_id = o.order_id
);

-- ============================================================
-- TRIGGER 2: LOG ORDER STATUS CHANGES
-- ============================================================
DELIMITER $$

CREATE TRIGGER trg_order_status_change
AFTER UPDATE ON orders
FOR EACH ROW
BEGIN
    IF OLD.status <> NEW.status THEN
        INSERT INTO order_status_log(order_id, old_status, new_status)
        VALUES (NEW.order_id, OLD.status, NEW.status);
    END IF;
END$$

DELIMITER ;

-- ============================================================
-- STORED PROCEDURE 1: GET USER ORDER HISTORY
-- ============================================================
DELIMITER $$

CREATE PROCEDURE sp_GetUserOrders(IN p_user_id INT)
BEGIN
    SELECT
        o.order_id,
        o.order_date,
        o.status,
        o.total_amount,
        o.shipping_address
    FROM orders o
    WHERE o.user_id = p_user_id
    ORDER BY o.order_date DESC;
END$$

DELIMITER ;

-- ============================================================
-- STORED PROCEDURE 2: CREATE AN ORDER WITH TRANSACTION
-- Checks stock before creating the order.
-- ============================================================
DELIMITER $$

CREATE PROCEDURE sp_CreateOrder(
    IN p_user_id INT,
    IN p_product_id INT,
    IN p_quantity INT,
    IN p_shipping_address VARCHAR(255),
    IN p_payment_method VARCHAR(20)
)
BEGIN
    DECLARE v_stock INT DEFAULT 0;
    DECLARE v_price DECIMAL(10,2) DEFAULT 0;
    DECLARE v_order_id INT;

    START TRANSACTION;

    SELECT stock_quantity, price
    INTO v_stock, v_price
    FROM products
    WHERE product_id = p_product_id
      AND is_active = TRUE
    FOR UPDATE;

    IF v_stock < p_quantity THEN
        ROLLBACK;
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Insufficient stock';
    ELSE
        INSERT INTO orders(user_id, status, shipping_address)
        VALUES(p_user_id, 'Confirmed', p_shipping_address);

        SET v_order_id = LAST_INSERT_ID();

        INSERT INTO order_items(order_id, product_id, quantity, unit_price)
        VALUES(v_order_id, p_product_id, p_quantity, v_price);

        UPDATE products
        SET stock_quantity = stock_quantity - p_quantity
        WHERE product_id = p_product_id;

        INSERT INTO payments(
            order_id, payment_method, amount, payment_status
        )
        VALUES(
            v_order_id,
            p_payment_method,
            v_price * p_quantity,
            CASE
                WHEN p_payment_method = 'COD' THEN 'Pending'
                ELSE 'Paid'
            END
        );

        COMMIT;

        SELECT v_order_id AS new_order_id,
               'Order created successfully' AS message;
    END IF;
END$$

DELIMITER ;

