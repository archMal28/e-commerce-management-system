-- ============================================================
-- 20 USEFUL REPORTING / RETRIEVAL QUERIES
-- ============================================================

-- Q1. Show all products
SELECT * FROM products;

-- Q2. Products with category names
SELECT p.product_id, p.product_name, c.category_name,
       p.price, p.stock_quantity
FROM products p
JOIN categories c ON p.category_id = c.category_id;

-- Q3. Low-stock products
SELECT product_id, product_name, stock_quantity
FROM products
WHERE stock_quantity < 30
ORDER BY stock_quantity;

-- Q4. All orders with customer names
SELECT o.order_id, u.full_name, o.order_date,
       o.status, o.total_amount
FROM orders o
JOIN users u ON o.user_id = u.user_id
ORDER BY o.order_date DESC;

-- Q5. Detailed order report
SELECT
    o.order_id,
    u.full_name AS customer,
    p.product_name,
    oi.quantity,
    oi.unit_price,
    oi.subtotal
FROM orders o
JOIN users u ON o.user_id = u.user_id
JOIN order_items oi ON o.order_id = oi.order_id
JOIN products p ON oi.product_id = p.product_id
ORDER BY o.order_id;

-- Q6. Total sales
SELECT SUM(total_amount) AS total_sales
FROM orders
WHERE status <> 'Cancelled';

-- Q7. Sales by category
SELECT
    c.category_name,
    SUM(oi.subtotal) AS category_sales
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id
JOIN categories c ON p.category_id = c.category_id
JOIN orders o ON oi.order_id = o.order_id
WHERE o.status <> 'Cancelled'
GROUP BY c.category_id, c.category_name
ORDER BY category_sales DESC;

-- Q8. Top-selling products
SELECT
    p.product_name,
    SUM(oi.quantity) AS units_sold,
    SUM(oi.subtotal) AS revenue
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id
JOIN orders o ON oi.order_id = o.order_id
WHERE o.status <> 'Cancelled'
GROUP BY p.product_id, p.product_name
ORDER BY units_sold DESC;

-- Q9. Customer-wise spending
SELECT
    u.user_id,
    u.full_name,
    SUM(o.total_amount) AS total_spent
FROM users u
JOIN orders o ON u.user_id = o.user_id
WHERE o.status <> 'Cancelled'
GROUP BY u.user_id, u.full_name
ORDER BY total_spent DESC;

-- Q10. Customers with more than one order
SELECT
    u.full_name,
    COUNT(o.order_id) AS total_orders
FROM users u
JOIN orders o ON u.user_id = o.user_id
GROUP BY u.user_id, u.full_name
HAVING COUNT(o.order_id) > 1;

-- Q11. Pending payments
SELECT p.payment_id, p.order_id, p.amount,
       p.payment_method, p.payment_status
FROM payments p
WHERE p.payment_status = 'Pending';

-- Q12. Orders above Rs. 2000
SELECT order_id, user_id, total_amount
FROM orders
WHERE total_amount > 2000;

-- Q13. Average order value
SELECT ROUND(AVG(total_amount),2) AS average_order_value
FROM orders
WHERE status <> 'Cancelled';

-- Q14. Count orders by status
SELECT status, COUNT(*) AS total_orders
FROM orders
GROUP BY status;

-- Q15. Products never ordered
SELECT p.product_id, p.product_name
FROM products p
LEFT JOIN order_items oi ON p.product_id = oi.product_id
WHERE oi.product_id IS NULL;

-- Q16. Most expensive product in each category
SELECT c.category_name, p.product_name, p.price
FROM products p
JOIN categories c ON p.category_id = c.category_id
WHERE p.price = (
    SELECT MAX(p2.price)
    FROM products p2
    WHERE p2.category_id = p.category_id
);

-- Q17. Payment summary
SELECT payment_status, SUM(amount) AS amount
FROM payments
GROUP BY payment_status;

-- Q18. Order status audit report
SELECT *
FROM order_status_log
ORDER BY changed_at DESC;

-- Q19. Customer and payment details
SELECT
    u.full_name,
    o.order_id,
    o.total_amount,
    p.payment_method,
    p.payment_status
FROM users u
JOIN orders o ON u.user_id = o.user_id
JOIN payments p ON o.order_id = p.order_id;

-- Q20. Monthly sales report
SELECT
    DATE_FORMAT(order_date,'%Y-%m') AS sales_month,
    SUM(total_amount) AS monthly_sales,
    COUNT(order_id) AS total_orders
FROM orders
WHERE status <> 'Cancelled'
GROUP BY DATE_FORMAT(order_date,'%Y-%m')
ORDER BY sales_month;

